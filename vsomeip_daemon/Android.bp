soong_config_module_type {
    name: "vsomeip_daemon_prebuilt_etc_defaults",
    module_type: "prebuilt_defaults",
    config_namespace: "qti",
    bool_variables: ["qti_android_version_above_16"],
    properties: ["installable"],
}

vsomeip_daemon_prebuilt_etc_defaults{
    name: "vsomeip_daemon_config_defaults",
    soong_config_variables: {
        qti_android_version_above_16: {
            installable: true,
            conditions_default: {
            installable: false,
           },
        },
    },
}

prebuilt_etc {
    name: "vsomeip_daemon_vsomeip_vlan1500_config",
    defaults: ["vsomeip_daemon_config_defaults"],
    vendor: true,
    filename_from_src: true,
    src:"config/vsomeip_vlan1500.json",
}

prebuilt_etc {
    name: "vsomeip_daemon_vsomeip_vlan1520_config",
    defaults: ["vsomeip_daemon_config_defaults"],
    vendor: true,
    filename_from_src: true,
    src: "config/vsomeip_vlan1520.json",
}

prebuilt_etc {
    name: "vsomeip_daemon_vsomeip_eth0_config",
    defaults: ["vsomeip_daemon_config_defaults"],
    vendor: true,
    filename_from_src: true,
    src: "config/vsomeip_eth0.json",
}

prebuilt_etc {
    name: "vsomeip_daemon_commonapi4someip_default_no_tp",
    defaults: ["vsomeip_daemon_config_defaults"],
    vendor: true,
    filename_from_src: true,
    src: "config/commonapi4someip_default_no_tp.ini",
}

prebuilt_etc {
    name: "vsomeip_daemon_commonapi4someip_default_tp",
    defaults: ["vsomeip_daemon_config_defaults"],
    vendor: true,
    filename_from_src: true,
    src: "config/commonapi4someip_default_tp.ini",
}

cc_defaults {
    name: "vsomeip_daemon_defaults",
    vendor: true,

    cppflags: [
        "-std=c++14",
        "-Wno-unused-parameter",
    ],

    shared_libs: [
        "libvsomeip3",
        "libvsomeip_cfg",
        "libvsomeip_e2e",
        "libvsomeip_sd",
        "liblog",
    ],
}

cc_binary {
    name: "vsomeip_daemon",
    defaults: ["vsomeip_daemon_defaults"],

    init_rc: ["vsomeip_daemon.rc"],
        
    srcs: [
        "src/vsomeip_daemon_main.cpp"
    ],
    
    local_include_dirs: [
    "include",
    ]
}