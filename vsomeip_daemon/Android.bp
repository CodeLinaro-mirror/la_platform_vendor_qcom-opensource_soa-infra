soong_config_bool_variable {
    name: "qti_android_version_above_16",
}

soong_config_module_type {
    name: "qti_prebuilt_etc",
    module_type: "prebuilt_etc",
    config_namespace: "qti",
    bool_variables: ["qti_android_version_above_16"],
    properties: [
        "installable",
    ],
}

qti_prebuilt_etc {
    name: "vsomeip_daemon_vsomeip_vlan1500_config",
    vendor: true,
    filename_from_src: true,
    src:"config/vsomeip_vlan1500.json",
    soong_config_variables: {
        qti_android_version_above_16: {
            installable: false,
            conditions_default: {
            installable: true,
           },
        },
    },
}

qti_prebuilt_etc {
    name: "vsomeip_daemon_vsomeip_vlan1520_config",
    vendor: true,
    filename_from_src: true,
    src: "config/vsomeip_vlan1520.json",
    soong_config_variables: {
        qti_android_version_above_16: {
            installable: false,
            conditions_default: {
	    installable: true,
            },
        },
    },
}

qti_prebuilt_etc {
    name: "vsomeip_daemon_vsomeip_eth0_config",
    vendor: true,
    filename_from_src: true,
    src: "config/vsomeip_eth0.json",
    soong_config_variables: {
        qti_android_version_above_16: {
            installable: false,
            conditions_default: {
	    installable: true,
            },
        },
    },
}

qti_prebuilt_etc {
    name: "vsomeip_daemon_commonapi4someip_default_no_tp",
    vendor: true,
    filename_from_src: true,
    src: "config/commonapi4someip_default_no_tp.ini",
    soong_config_variables: {
        qti_android_version_above_16: {
            installable: false,
            conditions_default: {
	    installable: true,
            },
        },
    },
}

qti_prebuilt_etc {
    name: "vsomeip_daemon_commonapi4someip_default_tp",
    vendor: true,
    filename_from_src: true,
    src: "config/commonapi4someip_default_tp.ini",
    soong_config_variables: {
        qti_android_version_above_16: {
            installable: false,
            conditions_default: {
	    installable: true,
            },
        },
    },
}

cc_defaults {
    name: "vsomeip_daemon_defaults",
    vendor: true,

    cppflags: [
        "-std=c++14",
        "-Wno-unused-parameter",
    ],

    shared_libs: [
        "libvsomeip3",
        "libvsomeip_cfg",
        "libvsomeip_e2e",
        "libvsomeip_sd",
        "liblog",
    ],
}

cc_binary {
    name: "vsomeip_daemon",
    defaults: ["vsomeip_daemon_defaults"],

    init_rc: ["vsomeip_daemon.rc"],
        
    srcs: [
        "src/vsomeip_daemon_main.cpp"
    ],
    
    local_include_dirs: [
    "include",
    ]
}
